# ==============================================================================
# WanderWise AI Frontend - Environment Variables Example
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# FastAPI Backend REST API URL
VITE_API_URL=http://localhost:8000/api

# Supabase Authentication & Database Keys
# Obtain these from your Supabase Dashboard: Project Settings -> API
# (Leave blank or default to use Development Mode with local persistence)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

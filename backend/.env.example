# ==============================================================================
# WanderWise AI Backend - Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Application Settings
PROJECT_NAME="WanderWise AI – Personalized Travel Itinerary Planner"
DEV_MODE=True

# CORS Origins (Comma-separated or list format)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","*"]

# Supabase Credentials (Required for Cloud Database & Auth)
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# Generative AI Provider Configuration (Part 2)
# Supported Providers: nvidia, openai, groq, gemini
# ------------------------------------------------------------------------------
AI_PROVIDER=nvidia

# NVIDIA NIM (Default)
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenAI Alternative
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Groq Alternative
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini Alternative
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
